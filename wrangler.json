{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "phanthuanxtra-v2",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/admin",
      "/admin/",
      "/api/*",
      "/media/*"
    ]
  },

  "observability": {
    "enabled": true
  },

  "ai": {
    "binding": "AI"
  },

  "images": {
    "binding": "IMAGES"
  },

  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "phanthuanxtra-media"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phanthuanxtra-db",
      "database_id": "8b6c0fc8-c278-4797-9cfa-3ec93d0c1b7d"
    }
  ],

  "cache": {
    "enabled": true
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
