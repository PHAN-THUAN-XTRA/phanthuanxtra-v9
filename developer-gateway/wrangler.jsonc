{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "phanthuanxtra-developer-gateway",
  "main": "src/dual-gateway.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "APK_RATE_LIMITER", "namespace_id": "2026092450", "simple": { "limit": 50, "period": 60 } }],
  "vars": {
    "GATEWAY_MODE": "readonly",
    "PRODUCTION_MUTATIONS_ENABLED": "false",
    "AI_PEER_FAILOVER_ENABLED": "true",
    "AI_PEER_POLICY_VERSION": "3",
    "UNIFIED_AI_ENABLED": "true",
    "DUAL_AI_ENABLED": "true",
    "DUAL_AI_DEEP_MODEL": "@cf/nvidia/nemotron-3-120b-a12b",
    "DUAL_AI_WIDE_MODEL": "@cf/zai-org/glm-4.7-flash",
    "UNIFIED_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  }
  // GATEWAY_READ_TOKEN remains a Cloudflare secret; never commit it.
  // GATEWAY_ALLOWED_ORIGINS remains environment configuration; never commit secrets.
}