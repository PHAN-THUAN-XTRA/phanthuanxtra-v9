# Never commit real values.
GATEWAY_READ_TOKEN=<set-as-cloudflare-secret>
GATEWAY_ALLOWED_ORIGINS=<exact-allowed-origin-list>
# GitHub App credentials and Cloudflare API credentials are intentionally not defined here.

# Gemini is opt-in. Store the real key only as a Cloudflare Worker secret.
GEMINI_API_KEY=<set-as-cloudflare-secret>
