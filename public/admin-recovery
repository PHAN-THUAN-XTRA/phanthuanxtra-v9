<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>PHAN THUẦN XTRA — Recovery</title><style>body{margin:0;background:#0b0b0b;color:#eee;font:15px system-ui,sans-serif}main{max-width:560px;margin:10vh auto;padding:20px}section{background:#131313;border:1px solid #2b2b2b;border-radius:14px;padding:24px}.field{display:grid;gap:7px;margin:16px 0}.field label{font-size:12px;color:#aaa}.field input{background:#0d0d0d;color:#fff;border:1px solid #3a3a3a;border-radius:8px;padding:12px;font:inherit;width:100%;box-sizing:border-box}.btn{background:#c9a96a;color:#111;border:1px solid #c9a96a;border-radius:8px;padding:11px 16px;cursor:pointer;font-weight:800}.muted{color:#999}.msg{margin-top:14px;white-space:pre-wrap}.ok{color:#bfe6bf}.err{color:#ffb2b2}code{word-break:break-all}.warn{border:1px solid #66562f;border-radius:8px;padding:12px;margin:14px 0}</style></head><body><main><section><h1>Admin Recovery</h1><p class="muted">Xoay mã khôi phục sẽ vô hiệu hóa mã cũ. Mã mới chỉ hiển thị một lần.</p><div class="warn">Nếu đang đăng nhập Admin, không cần nhập bootstrap token. Nếu quên cả mã khôi phục và chưa có phiên Admin, cần cấu hình <code>ADMIN_RECOVERY_ROTATE_TOKEN</code> trong Cloudflare Worker trước khi dùng chế độ khẩn cấp.</div><div class="field"><label>BOOTSTRAP ROTATE TOKEN — chỉ dùng khi không có phiên Admin</label><input id="rotateToken" type="password" autocomplete="off"></div><button class="btn" id="rotate">Xoay mã khôi phục</button><div id="msg" class="msg"></div><p><a href="/admin" style="color:#c9a96a">Quay lại Admin</a></p></section></main><script>const $=s=>document.querySelector(s);async function rotate(){const token=sessionStorage.getItem('ptx_admin_token')||'';const rotateToken=$('#rotateToken').value.trim();$('#rotate').disabled=true;$('#msg').textContent='Đang xoay mã...';try{const r=await fetch('/api/admin/recovery/rotate',{method:'POST',headers:{'Content-Type':'application/json',...(token?{Authorization:'Bearer '+token}:{})},body:JSON.stringify({rotateToken})});const d=await r.json().catch(()=>({}));if(!r.ok||!d.ok)throw Error(d.error||('HTTP '+r.status));$('#msg').className='msg ok';$('#msg').textContent='Mã khôi phục mới (chỉ hiển thị lần này):\n'+d.recoveryCode+'\n\nHãy lưu mã này trong password manager/secret store. Không gửi vào chat, issue hoặc log.';$('#rotateToken').value=''}catch(e){$('#msg').className='msg err';$('#msg').textContent=e.message}finally{$('#rotate').disabled=false}}$('#rotate').onclick=rotate;</script></body></html>
