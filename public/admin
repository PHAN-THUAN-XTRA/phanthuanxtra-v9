<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>PHAN THUẦN XTRA — Admin</title>
<style>
body{margin:0;background:#0b0b0b;color:#eee;font:15px system-ui,sans-serif}main{max-width:520px;margin:12vh auto;padding:24px}section{background:#131313;border:1px solid #2b2b2b;border-radius:14px;padding:24px}h1{margin-top:0}.muted{color:#999}.field{display:grid;gap:7px;margin:18px 0}.field label{font-size:12px;color:#aaa}.field input{background:#0d0d0d;color:#fff;border:1px solid #3a3a3a;border-radius:8px;padding:12px;font:inherit;width:100%;box-sizing:border-box}.btn{background:#c9a96a;color:#111;border:1px solid #c9a96a;border-radius:8px;padding:11px 16px;cursor:pointer;font-weight:800}.link{background:none;color:#c9a96a;border:0;padding:8px 0;cursor:pointer}.msg{margin-top:12px;min-height:20px}.err{color:#ffb2b2}.ok{color:#bfe6bf}.hidden{display:none}
</style>
</head>
<body>
<main id="login"><section>
<h1>PHAN THUẦN XTRA</h1>
<p class="muted">Đăng nhập Admin để quản lý và đăng xe lên website.</p>
<div id="loginForm">
<div class="field"><label for="password">MẬT KHẨU QUẢN TRỊ</label><input id="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu quản trị"></div>
<button class="btn" id="loginBtn">Đăng nhập</button>
<button class="link" id="forgotBtn" type="button">Quên mật khẩu?</button>
</div>
<div id="forgotForm" class="hidden">
<p class="muted">Dùng <b>mã khôi phục Admin</b> để đặt mật khẩu mới. Mã khôi phục không phải mật khẩu đăng nhập và không được gửi vào chat.</p>
<div class="field"><label for="recoveryCode">MÃ KHÔI PHỤC</label><input id="recoveryCode" type="password" autocomplete="off" placeholder="Nhập mã khôi phục Admin"></div>
<div class="field"><label for="newPassword">MẬT KHẨU MỚI</label><input id="newPassword" type="password" autocomplete="new-password" placeholder="Ít nhất 8 ký tự"></div>
<div class="field"><label for="confirmPassword">XÁC NHẬN MẬT KHẨU MỚI</label><input id="confirmPassword" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới"></div>
<button class="btn" id="resetBtn">Đặt mật khẩu mới</button>
<button class="link" id="backBtn" type="button">Quay lại đăng nhập</button>
</div>
<div id="loginMsg" class="msg"></div>
</section></main>
<script>
const $=s=>document.querySelector(s);
function msg(t,ok=false){$('#loginMsg').textContent=t;$('#loginMsg').className='msg '+(ok?'ok':'err')}
async function openControl(){
  location.replace('/admin-control.html');
}
async function login(){
  const password=$('#password').value.trim();
  if(!password){msg('Vui lòng nhập mật khẩu');return}
  $('#loginBtn').disabled=true;
  try{const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password})});const d=await r.json().catch(()=>({}));if(!r.ok||!d.ok)throw Error(d.error||'Đăng nhập thất bại');sessionStorage.setItem('ptx_admin_token',d.token);await openControl()}catch(e){msg(e.message);$('#loginBtn').disabled=false}
}
async function resetPassword(){
  const recoveryCode=$('#recoveryCode').value.trim(),password=$('#newPassword').value,confirm=$('#confirmPassword').value;
  if(!recoveryCode||!password||!confirm){msg('Vui lòng nhập đủ thông tin');return}
  if(password.length<8){msg('Mật khẩu mới phải có ít nhất 8 ký tự');return}
  $('#resetBtn').disabled=true;
  try{const r=await fetch('/api/admin/forgot-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({recoveryCode,password,confirm})});const d=await r.json().catch(()=>({}));if(!r.ok||!d.ok)throw Error(d.error||'Không thể đặt lại mật khẩu');$('#recoveryCode').value='';$('#newPassword').value='';$('#confirmPassword').value='';$('#forgotForm').classList.add('hidden');$('#loginForm').classList.remove('hidden');msg('Đã đặt mật khẩu mới. Hãy đăng nhập.',true)}catch(e){msg(e.message)}finally{$('#resetBtn').disabled=false}
}
$('#loginBtn').onclick=login;
$('#forgotBtn').onclick=()=>{$('#loginForm').classList.add('hidden');$('#forgotForm').classList.remove('hidden');msg('')};
$('#backBtn').onclick=()=>{$('#forgotForm').classList.add('hidden');$('#loginForm').classList.remove('hidden');msg('')};
$('#resetBtn').onclick=resetPassword;
$('#password').onkeydown=e=>{if(e.key==='Enter')login()};
if(sessionStorage.getItem('ptx_admin_token'))openControl().catch(e=>{sessionStorage.removeItem('ptx_admin_token');msg(e.message)});
</script>
</body></html>
