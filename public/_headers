/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/*.html
  Cache-Control: no-cache

/images/*
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/script.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/hero-carousel.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/blog-latest.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/data/*
  Cache-Control: public, max-age=300

# Telegram Mini App must be embeddable by Telegram Web/Desktop.
# This path-specific block overrides the global DENY only for the Mini App.
/telegram-mini-app.html
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors https://web.telegram.org https://*.telegram.org
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
